{
  "name": "dsh-worktree-manager",
  "version": "0.2.1",
  "description": "DeepSeek Harness 桌面版插件：在空白会话中选择基础分支与运行环境（本机 / Worktree）；Worktree 在 .agents/worktrees 下创建隔离 git worktree 并注册为 Workspace；会话头部提供合并（merge / squash）、删除与自动清理。",
  "keywords": [
    "dsh",
    "deepseek",
    "cordis",
    "plugin",
    "git",
    "worktree"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./wire": {
      "types": "./lib/wire.d.ts",
      "default": "./lib/wire.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/**/*.map",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "icon.svg"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:client": "tsdown",
    "build:all": "pnpm run build && pnpm run build:client",
    "watch:client": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm test && pnpm run build:all"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-rc.1 <0.3.0-0 || >=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.1.7-rc.1 <0.3.0-0 || >=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-api-gateway": "0.2.0-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.1",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.1",
    "@deepseek-ai/dsh-util-code-language": "0.2.0-rc.1",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.3",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "clsx": "^2.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.14.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zustand": "~4.4.7"
  },
  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "pnpm@11.8.0"
}
